# ============================================================
#  The Cartographer — .gitignore
# ============================================================


# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Entornos virtuales
.venv/
venv/
env/
ENV/

# mypy / pyright / pytype
.mypy_cache/
.pyright/
.pytype/

# pytest
.pytest_cache/
.coverage
htmlcov/


# ── Bases de datos SQLite (datos de ejecución) ───────────────
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3


# ── SSL / TLS (certificados y claves privadas) ───────────────
nginx/ssl/
# Patrón amplio por si se generan en otra ubicación
*.key
*.pem
*.crt
*.csr


# ── Secretos y configuración local ───────────────────────────
.env
.env.*
!.env.example


# ── Docker (volúmenes locales, si se montan en disco) ────────
# Los ficheros docker-compose.yml sí se versionan.
# Excluir únicamente datos persistentes montados localmente.
data/


# ── Editor — VS Code ─────────────────────────────────────────
.vscode/
# Excepto configuración compartida del workspace (opcional):
# !.vscode/settings.json
# !.vscode/extensions.json


# ── Editor — JetBrains ───────────────────────────────────────
.idea/
*.iml


# ── Sistema operativo ─────────────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# Linux
*~


# ── Logs ─────────────────────────────────────────────────────
*.log
logs/


# ── Node (por si se añade un bundler en el futuro) ───────────
node_modules/
npm-debug.log*
dist/
.parcel-cache/


# ── Archivos temporales ───────────────────────────────────────
*.tmp
*.bak
*.swp
*.swo
.cache/

*.gpx
secret_datas.md
meteo_data.md


# ── Rust ─────────────────────────────────────────────────────
/target